# Copy to /opt/vinolog/.env on the VPS and replace every secret.
# Generate values with: openssl rand -hex 24

# Domain pointed at the VPS (A record). Leave ":80" to serve HTTP by IP.
VINOLOG_DOMAIN=:80

VINLOG_DB_PASSWORD=change-me
VINLOG_S3_ACCESS_KEY=vinolog
VINLOG_S3_SECRET_KEY=change-me

NUXT_PUBLIC_ASTRO_ENABLED=true
NUXT_PUBLIC_SOMMELIER_MODE=mock
NUXT_SOMMELIER_PROVIDER=openai
NUXT_SOMMELIER_MODEL=
NUXT_SOMMELIER_MAX_REQUESTS=20
NUXT_SOMMELIER_API_KEY=

# Per-stage trace in scan responses for the result page's debug panel.
RANKING_DEBUG=false
