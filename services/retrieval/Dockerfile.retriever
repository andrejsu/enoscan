FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/scripts

WORKDIR /app

COPY services/retrieval/requirements.txt services/retrieval/requirements-ocr.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ocr.txt \
    && pip install --no-cache-dir --no-deps rapidocr==3.9.2
RUN python -c "from rapidocr import LangRec, ModelType, OCRVersion, RapidOCR; RapidOCR(params={'Rec.lang_type': LangRec.CYRILLIC, 'Rec.ocr_version': OCRVersion.PPOCRV5, 'Rec.model_type': ModelType.MOBILE, 'Global.log_level': 'error'})"

COPY services/retrieval/app ./app
COPY scripts/label_prep.py ./scripts/label_prep.py

EXPOSE 8000
CMD ["uvicorn", "app.retriever_main:app", "--host", "0.0.0.0", "--port", "8000"]
