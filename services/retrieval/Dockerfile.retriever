# Standalone wine-label retriever image — separate from ./Dockerfile, which
# builds the existing OCR-driven service and stays untouched by this file.
# Build context is the repo root (not services/retrieval) because this
# service needs scripts/label_prep.py.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/scripts

WORKDIR /app

COPY services/retrieval/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY services/retrieval/app ./app
COPY scripts/label_prep.py ./scripts/label_prep.py

EXPOSE 8000
CMD ["uvicorn", "app.retriever_main:app", "--host", "0.0.0.0", "--port", "8000"]
