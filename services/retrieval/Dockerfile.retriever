# Shared image for the three standalone services that sit next to the main
# scanner (./Dockerfile, which stays visual-only and untouched by this
# file): the visual retriever (app.retriever_main), the OCR field extractor
# (app.ocr_main) and ranking (app.ranking_main), which needs both. One
# image instead of one-Dockerfile-per-service — each service just points
# `command:` in compose.yaml at its own uvicorn target. Build context is
# the repo root (not services/retrieval) because this needs
# scripts/label_prep.py.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/scripts

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-rus \
    && rm -rf /var/lib/apt/lists/*

COPY services/retrieval/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY services/retrieval/app ./app
COPY scripts/label_prep.py ./scripts/label_prep.py

EXPOSE 8000
CMD ["uvicorn", "app.retriever_main:app", "--host", "0.0.0.0", "--port", "8000"]
